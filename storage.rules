rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if file is a PDF
    function isPDF() {
      return request.resource.contentType == 'application/pdf';
    }

    // Helper function to check if file size is reasonable (max 10MB)
    function isReasonableSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Quotation PDFs
    match /quotations/{projectId}/{bomItemId}/{fileName} {
      // Allow authenticated users to upload PDFs for their projects
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && isPDF()
                   && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // Regular documents for BOM items (any file type)
    match /documents/{bomItemId}/{fileName} {
      // Allow authenticated users to upload documents
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // Project documents (vendor quotes, POs, customer POs)
    match /projects/{projectId}/documents/{docType}/{fileName} {
      // Allow authenticated users to upload project documents
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // Post-commissioning support documents (manuals, drawings, logs, quotes, RCA)
    match /projects/{projectId}/support/{scope}/{docType}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // Vendor logos
    match /vendor-logos/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // Brand logos
    match /brand-logos/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // Client logos
    match /client-logos/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // Company logos (for PO generation)
    match /company-logos/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // Received item photos (proof of delivery)
    // Native receipt uploads are a separate exact path. Legacy {fileName} below
    // cannot match this extra segment, so its write/delete grants never overlap.
    function nativeUploadModeAllowsWrite() {
      return !firestore.exists(/databases/(default)/documents/pulseRuntimeControl/cutover)
        || firestore.get(/databases/(default)/documents/pulseRuntimeControl/cutover).data.mode in ['coexist', 'pulse_only'];
    }
    function nativeUploadMember(intent, projectId) {
      let project = firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
      let internal = request.auth.token.email.lower().matches('.*@qualitastech[.]com');
      // Arrays have no Rules-side search. Bind the scoped member's index at
      // reserve time and fail closed if membership is reordered before upload.
      let scoped = 'members' in project && intent.member_index is int
        && intent.member_index >= 0 && intent.member_index < project.members.size()
        && project.members[intent.member_index].userId == request.auth.uid
        && 'categoryScope' in project.members[intent.member_index]
        && intent.category in project.members[intent.member_index].categoryScope;
      return request.auth.token.role == 'admin'
        || ('memberIds' in project && request.auth.uid in project.memberIds
          && (internal || scoped));
    }
    function nativeUploadActor(intent, projectId, fileName) {
      return request.auth != null
        && request.auth.token.status == 'approved'
        && request.auth.token.email_verified == true
        && request.auth.token.role in ['admin', 'user', 'viewer']
        && intent.actor_uid == request.auth.uid
        && intent.actor_email == request.auth.token.email.lower()
        && intent.project_id == projectId
        && intent.path == 'projects/' + projectId + '/received-photos/native/' + fileName
        && nativeUploadMember(intent, projectId);
    }
    match /projects/{projectId}/received-photos/native/{fileName} {
      // Intent/audit collections are outside the writable legacy project wildcard.
      // Storage rules cannot revalidate Firebase Auth revocation. Both callables do.
      allow create: if fileName.matches('[a-f0-9]{64}[.]jpg')
        && firestore.exists(/databases/(default)/documents/pulseNativeUploadIntents/$(fileName))
        && nativeUploadModeAllowsWrite()
        && nativeUploadActor(firestore.get(/databases/(default)/documents/pulseNativeUploadIntents/$(fileName)).data, projectId, fileName)
        && firestore.get(/databases/(default)/documents/pulseNativeUploadIntents/$(fileName)).data.state == 'reserved'
        && request.time < firestore.get(/databases/(default)/documents/pulseNativeUploadIntents/$(fileName)).data.expires_at
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0 && request.resource.size < 10 * 1024 * 1024
        && request.resource.size == firestore.get(/databases/(default)/documents/pulseNativeUploadIntents/$(fileName)).data.byte_size;
      allow read: if firestore.exists(/databases/(default)/documents/pulseNativeUploadIntents/$(fileName))
        && nativeUploadActor(firestore.get(/databases/(default)/documents/pulseNativeUploadIntents/$(fileName)).data, projectId, fileName)
        && firestore.get(/databases/(default)/documents/pulseNativeUploadIntents/$(fileName)).data.state == 'finalized';
      allow update, delete: if false;
    }
    match /projects/{projectId}/received-photos/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.contentType.matches('image/.*')
                   && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // Travel expense receipts (images or PDFs)
    match /projects/{projectId}/receipts/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
                   && isReasonableSize();
      allow delete: if isAuthenticated();
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
